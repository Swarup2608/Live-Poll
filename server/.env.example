# Server
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins
# Example: http://localhost:3000,https://app.example.com
CLIENT_ORIGINS=http://localhost:3000

# Single client origin used as the OAuth/reset-password redirect target
CLIENT_ORIGIN=http://localhost:3000

# If running behind a reverse proxy/load balancer in production, set to 1
TRUST_PROXY=0

# Postgres connection string (see root docker-compose.yml for local dev)
DATABASE_URL=postgresql://loopballot:loopballot@localhost:5432/loopballot?schema=public

# Secret used to sign short-lived access JWTs. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Secret used to sign the session-hint/CSRF-state cookies. Generate with: openssl rand -base64 48
COOKIE_SECRET=

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
