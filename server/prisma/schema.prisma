generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum Theme {
  light
  dark
  midnight
  professional
  disco
  shootout
  sea
  grayscale
  sunset
  forest
}

enum PlanId {
  starter
  team
  enterprise
}

enum OrgRole {
  Owner
  Admin
  Editor
  Viewer
}

enum MemberStatus {
  invited
  active
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique @db.Citext
  passwordHash   String?  @map("password_hash")
  googleId       String?  @unique @map("google_id")
  website        String?
  avatarUrl      String?  @map("avatar_url")
  notify         Boolean  @default(true)
  preferredTheme Theme    @default(light) @map("preferred_theme")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships    OrganizationMember[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  currentPlanId        PlanId   @default(starter) @map("current_plan_id")
  stripeCustomerId     String?  @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  members OrganizationMember[]

  @@map("organizations")
}

// user_id is nullable to represent an outstanding invite (status: invited) before it's accepted.
// The unique index on (org_id, user_id) still enforces "one active membership per user per org"
// once accepted, since Postgres treats each NULL as distinct and allows many pending-invite rows.
model OrganizationMember {
  id           String       @id @default(uuid())
  orgId        String       @map("org_id")
  userId       String?      @map("user_id")
  role         OrgRole
  invitedEmail String?      @map("invited_email")
  status       MemberStatus @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

// Phase-0-internal: records issued/revoked refresh tokens so "rotating httpOnly refresh cookie"
// and logout/reset-triggered session invalidation are real, not just cookie-deletion theater.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Phase-0-internal: server-side token record that /auth/reset-password validates against.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
